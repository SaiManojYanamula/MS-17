DATABASE_URL="mysql://user:password@localhost:3306/study_hall_saas"
JWT_SECRET="replace-with-a-long-random-secret"
PORT=4000
REDIS_URL="redis://localhost:6379"

# Optional — leave unset to disable. See backend/src/notifications/notifications.service.ts
# for what to wire up once you have a provider (SMS needs India DLT registration).
SMS_API_KEY=
SMS_SENDER_ID=
WHATSAPP_API_KEY=
WHATSAPP_PHONE_ID=

# Cloudflare R2 — file uploads (receipts, Aadhar cards, cover images).
# R2_ACCOUNT_ID: Cloudflare dashboard > R2 > Overview (right side)
# R2_PUBLIC_URL: your bucket's public dev URL (https://pub-xxxx.r2.dev) or custom domain, no trailing slash
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# A SEPARATE, private R2 bucket for daily DB backups — do NOT reuse
# R2_BUCKET_NAME above or give this bucket public access. A backup contains
# every tenant's data (password hashes, phone numbers, payments, UPI IDs), so
# it's only ever fetched via short-lived presigned URLs, never a public link.
# Same R2 account/keys work as long as the API token has access to this bucket too.
R2_BACKUP_BUCKET_NAME=
