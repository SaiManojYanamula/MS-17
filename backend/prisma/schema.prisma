// Study Hall Management SaaS — Prisma Schema
// Multi-tenancy model: Shared DB, row-level isolation via tenantId

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  TENANT_OWNER
  BRANCH_MANAGER
  STAFF
  STUDENT
}

enum SubscriptionPlan {
  BASIC
  STANDARD
  PREMIUM
}

enum ApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum SeatStatus {
  FREE
  OCCUPIED
  EXPIRING_SOON
}

enum PlanType {
  MONTHLY
  QUARTERLY
  DAILY_PASS
}

enum PaymentMethod {
  UPI
  CASH
  CARD
  PENDING
}

enum PaymentStatus {
  PAID
  PENDING
  REFUNDED
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  TRIAL
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  HOLIDAY
}

enum RequestType {
  RENEWAL
  SEAT_CHANGE
  ISSUE
  OTHER
}

enum RequestStatus {
  OPEN
  RESOLVED
}

model Tenant {
  id        String           @id @default(uuid())
  name      String
  slug      String           @unique
  status    TenantStatus     @default(ACTIVE)
  plan      SubscriptionPlan @default(BASIC)
  upiId          String? // owner's UPI ID (e.g. "name@okhdfcbank") — shown as a payment QR during self-service seat booking
  upiPhone       String? // owner's phone number for GPay/PhonePe, shown alongside the UPI QR
  coverImageUrl  String? // branding image shown behind the public QR/booking page
  notifyExpiry   Boolean          @default(true) // send membership expiry reminders
  notifyPayments Boolean          @default(true) // send payment received/booking confirmed alerts
  notifyWhatsapp Boolean          @default(false) // also send the above via WhatsApp, not just SMS
  // Platform-controlled gate — a tenant owner can only turn notifyWhatsapp on
  // once the super-admin has granted this. Since each WhatsApp message costs
  // the platform money, this is the rollout/billing control point.
  whatsappAccessEnabled Boolean   @default(false)
  // Comma-separated feature keys this org has access to — Super Admin picks
  // exactly which optional modules each org gets, independent of plan.
  // Core modules (Members/Payments/Settings/Dashboard) are never gated.
  enabledFeatures String @default("EXPENSES,NOTICES,REQUESTS,SEATING,REPORTS,ATTENDANCE")
  createdAt      DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  branches Branch[]
  users    User[]
  members  Member[]
  whatsappLogs WhatsAppMessageLog[]
}

// One row per WhatsApp send attempt — powers the super-admin's per-org usage
// view (message volume is the thing that costs the platform money).
model WhatsAppMessageLog {
  id        String   @id @default(uuid())
  tenantId  String
  phone     String
  direction String // "outbound" (business-initiated) or "reply" (session reply)
  status    String // "sent" or "failed"
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([createdAt])
}

model Branch {
  id        String   @id @default(uuid())
  tenantId  String
  name      String
  address   String?
  createdAt DateTime @default(now())

  tenant       Tenant             @relation(fields: [tenantId], references: [id])
  zones        Zone[]
  members      Member[]
  applications Application[]
  payments     Payment[]
  users        User[]
  expenses     Expense[]
  attendance   Attendance[]
  notices      Notice[]
  requests     Request[]
  userAccess   UserBranchAccess[]

  @@index([tenantId])
}

model User {
  id        String   @id @default(uuid())
  tenantId  String? // null for SUPER_ADMIN — the only role not scoped to one tenant
  branchId  String? // primary/default branch — used when creating new records with no explicit branch context
  name      String
  email     String   @unique
  password  String
  role      Role
  isActive  Boolean  @default(true)
  memberId  String?  @unique // set when role is STUDENT — links the login to their Member record
  createdAt DateTime @default(now())

  tenant       Tenant?            @relation(fields: [tenantId], references: [id])
  branch       Branch?            @relation(fields: [branchId], references: [id])
  member       Member?            @relation(fields: [memberId], references: [id])
  branchAccess UserBranchAccess[]

  @@index([tenantId])
}

// Extra branches a BRANCH_MANAGER/STAFF user can switch into beyond their
// primary User.branchId. TENANT_OWNER never needs rows here — ownership of
// the tenant implicitly grants access to every branch under it.
model UserBranchAccess {
  id       String @id @default(uuid())
  userId   String
  branchId String

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([userId, branchId])
  @@index([branchId])
}

model Zone {
  id        String @id @default(uuid())
  tenantId  String
  branchId  String
  name      String // e.g. "Zone A - Window Row"
  startSeat Int
  endSeat   Int

  branch Branch @relation(fields: [branchId], references: [id])
  seats  Seat[]

  @@index([tenantId])
  @@index([branchId])
}

model Seat {
  id         String     @id @default(uuid())
  tenantId   String
  branchId   String
  zoneId     String
  seatNumber Int
  status     SeatStatus @default(FREE)
  memberId   String?    @unique

  zone   Zone    @relation(fields: [zoneId], references: [id])
  member Member? @relation(fields: [memberId], references: [id])

  @@unique([branchId, seatNumber])
  @@index([tenantId])
}

model Member {
  id        String   @id @default(uuid())
  tenantId  String
  branchId  String
  displayId String?  @unique // e.g. "AKR-2214" — shown to the student as their Student ID
  name      String
  phone     String? // also used as the login username for their auto-created STUDENT account
  goalTag   String? // e.g. "UPSC Aspirant", "NEET Aspirant"
  plan      PlanType
  batch     String // e.g. "Morning", "Day", "Evening"
  expiresAt DateTime
  status    String   @default("Active") // Active / Expiring Soon / Expired
  joinedAt  DateTime @default(now())
  aadharUrl String? // path to uploaded Aadhar card image/PDF, carried over from Application on approval
  feeReminderSentAt DateTime? // last time the fee-due WhatsApp reminder was sent for the *current* expiresAt — reset whenever expiresAt changes (renewal), so a renewed member can be reminded again next cycle

  tenant     Tenant       @relation(fields: [tenantId], references: [id])
  branch     Branch       @relation(fields: [branchId], references: [id])
  seat       Seat?
  payments   Payment[]
  user       User?
  attendance Attendance[]
  requests   Request[]

  @@index([tenantId])
  @@index([branchId])
}

model Application {
  id        String            @id @default(uuid())
  tenantId  String
  branchId  String
  applicant String
  goalTag   String?
  plan      PlanType
  batch     String
  aadharUrl String? // path to uploaded Aadhar card image/PDF
  appliedAt DateTime          @default(now())
  status    ApplicationStatus @default(PENDING)

  branch Branch @relation(fields: [branchId], references: [id])

  @@index([tenantId])
  @@index([branchId])
}

model Payment {
  id        String        @id @default(uuid())
  tenantId  String
  branchId  String
  memberId  String
  amount    Int
  method    PaymentMethod
  status    PaymentStatus @default(PENDING)
  label     String // e.g. "Monthly Renewal", "Quarterly Plan", "Daily Pass"
  screenshotUrl String? // proof-of-payment screenshot from the public self-booking flow
  createdAt DateTime      @default(now())

  branch Branch @relation(fields: [branchId], references: [id])
  member Member @relation(fields: [memberId], references: [id])

  @@index([tenantId])
  @@index([branchId])
}

model Expense {
  id         String   @id @default(uuid())
  tenantId   String
  branchId   String
  category   String // e.g. "Rent", "Electricity", "Salaries", "Maintenance", "Supplies", "Other"
  amount     Int
  note       String?
  receiptUrl String? // uploaded photo/PDF of the bill
  createdAt  DateTime @default(now())

  branch Branch @relation(fields: [branchId], references: [id])

  @@index([tenantId])
  @@index([branchId])
}

model Attendance {
  id        String           @id @default(uuid())
  tenantId  String
  branchId  String
  memberId  String
  date      DateTime         @db.Date
  status    AttendanceStatus
  createdAt DateTime         @default(now())

  branch Branch @relation(fields: [branchId], references: [id])
  member Member @relation(fields: [memberId], references: [id])

  @@unique([memberId, date])
  @@index([tenantId])
  @@index([branchId])
}

model Notice {
  id        String   @id @default(uuid())
  tenantId  String
  branchId  String
  title     String
  body      String
  // Optional holiday/closure date range shown alongside the notice — most
  // notices are plain announcements and leave these unset.
  startDate DateTime?
  endDate   DateTime?
  createdAt DateTime @default(now())

  branch Branch @relation(fields: [branchId], references: [id])

  @@index([tenantId])
  @@index([branchId])
}

model Request {
  id        String        @id @default(uuid())
  tenantId  String
  branchId  String
  memberId  String
  type      RequestType
  message   String
  status    RequestStatus @default(OPEN)
  createdAt DateTime      @default(now())

  branch Branch @relation(fields: [branchId], references: [id])
  member Member @relation(fields: [memberId], references: [id])

  @@index([tenantId])
  @@index([branchId])
}

// A tenant owner has nobody above them in-app to reset their password (unlike
// staff/students, whose owner/admin can do it directly) — this is their
// "forgot password" path: an unauthenticated request the Super Admin actions.
model PasswordResetRequest {
  id        String   @id @default(uuid())
  email     String
  status    String   @default("OPEN") // OPEN / RESOLVED
  createdAt DateTime @default(now())

  @@index([status])
}
